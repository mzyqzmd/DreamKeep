    _condition: 1
    _conditionValue: 80
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u628A\u516B\u5341\u679A\u91D1\u5E01\u4E00\u679A\u679A\u6309\u8FDB\u6CC9\u91CC\uFF0C\u91D1\u5E01\u6C89\u5E95\uFF0C\u4E24\u74F6\u6CDB\u7740\u5FAE\u5149\u7684\u836F\u6C34\u4FBF\u4ECE\u6C34\u5E95\u6D6E\u4E0A\u6765\uFF0C\u7A33\u7A33\u505C\u5728\u4F60\u9762\u524D\u3002\u9762\u677F\u4E0A\u5B83\u4FE9\u5E76\u6392\u8EBA\u7740\uFF0C\u4F60\u4E00\u74F6\u4E00\u74F6\u5730\u9886\u2014\u2014\u69FD\u4F4D\u82E5\u5DF2\u585E\u6EE1\uFF0C\u5C31\u5148\u559D\u6389\u4E00\u74F6\u817E\u51FA\u5730\u65B9\u518D\u56DE\u6765\u62FF\u3002\u4E24\u74F6\u90FD\u6765\u81EA\u666E\u901A\u836F\u6C34\u6C60\uFF0C\u5FAE\u5149\u4E0D\u7B97\u60CA\u8273\uFF0C\u5374\u662F\u5B9E\u6253\u5B9E\u80FD\u63E3\u8D70\u7684\u5E95\u724C\u3002"
    _effects:
