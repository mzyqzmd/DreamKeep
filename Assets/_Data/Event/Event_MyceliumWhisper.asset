  m_Name: Event_MyceliumWhisper
  m_EditorClassIdentifier: 
  _eventName: "\u83cc\u4e1d\u4f4e\u8bed"
  _background: {fileID: 11400000, guid: a46d659167da82e428f00796b6f47c33, type: 2}
  _narrative: "\u8d70\u5eca\u7684\u5899\u76ae\u9f13\u8d77\u4e00\u7247\uff0c\u50cf\u6709\u4ec0\u4e48\u4e1c\u897f\u5728\u5e95\u4e0b\u547c\u5438\u3002\u4f60\u51d1\u8fd1\uff0c\u90a3\u7247\u9f13\u8d77\u7684\u5730\u65b9\u88c2\u5f00\u7ec6\u7f1d\uff0c\u6e17\u51fa\u4e00\u7ebf\u51b7\u767d\u7684\u5149\u2014\u2014\u662f\u83cc\u4e1d\u3002\u5b83\u4eec\u987a\u7740\u7816\u7f1d\u5f80\u4e0a\u722c\uff0c\u5728\u5899\u9762\u4e0a\u7ec7\u51fa\u4e00\u5f20\u758f\u758f\u7684\u7f51\uff0c\u7f51\u773c\u91cc\u60ac\u7740\u7ec6\u5c0f\u7684\u5b62\u5b50\uff0c\u968f\u4f60\u7684\u547c\u5438\u4e00\u660e\u4e00\u6697\u3002\u6709\u58f0\u97f3\u8d34\u7740\u8033\u9aa8\u54cd\u8d77\u6765\uff0c\u4e0d\u662f\u8bdd\uff0c\u662f\u8bb8\u591a\u542b\u6df7\u7684\u97f3\u8282\u53e0\u5728\u4e00\u8d77\uff0c\u50cf\u6709\u4eba\u628a\u4e00\u6574\u6bb5\u56de\u5fc6\u56bc\u788e\u4e86\u518d\u5410\u51fa\u6765\u3002\u5b83\u8bf4\u53ef\u4ee5\u66ff\u4f60\u6d88\u5316\u6389\u4e24\u5f20\u6700\u6c89\u7684\u724c\uff0c\u6761\u4ef6\u662f\u7559\u4e0b\u5b83\u5728\u4f60\u80f8\u53e3\u542c\u89c1\u7684\u4e00\u9897\u4e1c\u897f\uff1b\u5b83\u4e5f\u53ef\u4ee5\u628a\u4e00\u6ef4\u6d53\u7f29\u7684\u5b62\u5b50\u9732\u6c34\u63a8\u7ed9\u4f60\uff0c\u53ea\u8981\u4f60\u80af\u7528\u8840\u53bb\u6d47\u3002"
  _options:
  - _name: "\u8ba9\u83cc\u4e1d\u5403\u6389\u4e24\u5f20\u724c"
    _subtitle: "\u4ece\u4f60\u7684\u724c\u5e93\u4e2d\u79fb\u9664 <color=yellow>2</color> \u5f20\u724c\uff0c\u5c06\u4e00\u5f20 <color=yellow>\u5b62\u5b50\u4e4b\u5fc3</color> \u52a0\u5165\u4f60\u7684\u724c\u5e93"
    _condition: 3
    _conditionValue: 2
    _displayCard: {fileID: 11400000, guid: 6725531547820ae48a45922a00729c9e, type: 2}
    _resultText: "\u4f60\u6311\u51fa\u4e24\u5f20\u6700\u4e0d\u613f\u518d\u62ff\u8d77\u6765\u7684\u724c\uff0c\u4e00\u5f20\u63a5\u4e00\u5f20\u6309\u8fdb\u5899\u9762\u90a3\u9053\u88c2\u7f1d\u3002\u83cc\u4e1d\u7acb\u523b\u6d8c\u4e0a\u6765\uff0c\u50cf\u767d\u7eb8\u5438\u58a8\u4e00\u6837\u628a\u5b83\u4eec\u6d78\u900f\u3001\u5316\u5f00\uff0c\u8fde\u75d5\u8ff9\u90fd\u6ca1\u7559\u5728\u7816\u4e0a\u3002\u5899\u5e95\u968f\u5373\u6d6e\u8d77\u4e00\u9897\u6307\u7532\u76d6\u5927\u5c0f\u7684\u4e1c\u897f\uff0c\u534a\u900f\u660e\uff0c\u91cc\u9762\u88f9\u7740\u4e00\u5708\u7f13\u6162\u8f6c\u52a8\u7684\u4e1d\u2014\u2014\u90a3\u5c31\u662f\u5b83\u8bf4\u7684\u300c\u5b62\u5b50\u4e4b\u5fc3\u300d\u3002\u5b83\u81ea\u5df1\u94bb\u8fdb\u4f60\u7684\u724c\u7ec4\uff0c\u5b89\u9759\u5f97\u50cf\u662f\u672c\u6765\u5c31\u5c5e\u4e8e\u90a3\u91cc\u3002\u4f60\u6478\u4e86\u6478\u80f8\u53e3\uff0c\u90a3\u91cc\u5c11\u4e86\u4e00\u6bb5\u8bb0\u5fc6\uff0c\u53c8\u591a\u4e86\u4e00\u56e2\u8f7b\u8f7b\u640f\u52a8\u7684\u4e1c\u897f\u3002"
    _effects:
    - rid: 71023846001
    - rid: 71023846002
  - _name: "\u5272\u5f00\u624b\u6307\u5582\u83cc\u6bef"
    _subtitle: "\u5931\u53bb <color=red>8</color> \u70b9\u751f\u547d\uff0c\u83b7\u5f97 <color=yellow>1</color> \u74f6\u968f\u673a\u7a00\u6709\u836f\u6c34"
    _condition: 2
    _conditionValue: 8
    _displayCard: {fileID: 0}
    _resultText: "\u4f60\u7528\u6307\u7532\u5728\u638c\u5fc3\u5212\u5f00\u4e00\u9053\u53e3\u5b50\uff0c\u628a\u8840\u6309\u5728\u83cc\u6bef\u4e0a\u3002\u767d\u8272\u83cc\u4e1d\u50cf\u95fb\u5230\u96e8\u7684\u6c99\u5730\uff0c\u7acb\u523b\u671d\u8840\u8ff9\u805a\u62e2\uff0c\u4e00\u6839\u6839\u7acb\u8d77\u6765\uff0c\u6296\u4e86\u6296\uff0c\u4ece\u9876\u7aef\u6eda\u51fa\u4e00\u9897\u4eae\u5f97\u53d1\u51b7\u7684\u9732\u73e0\u3002\u4f60\u628a\u5b83\u63a5\u8fdb\u7a7a\u836f\u74f6\u91cc\uff0c\u74f6\u58c1\u4e0a\u7684\u5149\u6162\u6162\u6c89\u4e0b\u53bb\uff0c\u53d8\u6210\u4e00\u5c0f\u6c6a\u770b\u5f97\u89c1\u7684\u6d53\u7a20\u2014\u2014\u6765\u81ea\u7a00\u6709\u836f\u6c34\u6c60\u7684\u771f\u8d27\uff0c\u4e0d\u662f\u5899\u7f1d\u91cc\u90a3\u79cd\u4e00\u78b0\u5c31\u6563\u7684\u865a\u5149\u3002\u638c\u5fc3\u7684\u53e3\u5b50\u8fd8\u5728\u6e17\u8840\uff0c\u4f60\u6525\u7d27\u624b\uff0c\u89c9\u5f97\u8fd9\u70b9\u4ee3\u4ef7\u6362\u6765\u7684\u4e1c\u897f\uff0c\u591f\u6491\u8fc7\u4e0b\u9762\u51e0\u5c42\u3002"
    _effects:
    - rid: 71023846003
    - rid: 71023846004
  - _name: "\u8f6c\u8eab\u79bb\u5f00"
    _subtitle: "\u7ed3\u675f\u4e8b\u4ef6\uff0c\u4ec0\u4e48\u4e5f\u4e0d\u53d1\u751f"
    _condition: 0
    _conditionValue: 0
    _displayCard: {fileID: 0}
    _resultText: "\u4f60\u6ca1\u4f38\u624b\uff0c\u4e5f\u6ca1\u63a5\u90a3\u53e5\u8bdd\uff0c\u53ea\u628a\u80cc\u8f6c\u5411\u90a3\u9762\u6b63\u5728\u547c\u5438\u7684\u5899\u3002\u83cc\u4e1d\u5728\u4f59\u5149\u91cc\u53c8\u5f80\u4e0a\u722c\u4e86\u4e24\u5bf8\uff0c\u89c1\u4f60\u4e0d\u52a8\uff0c\u4fbf\u6162\u6162\u7f29\u56de\u7f1d\u91cc\uff0c\u51b7\u767d\u7684\u5149\u4e00\u5bf8\u5bf8\u6697\u4e0b\u53bb\u3002\u8d70\u5eca\u91cd\u65b0\u53d8\u5f97\u53ea\u6709\u4e00\u79cd\u58f0\u97f3\u2014\u2014\u4f60\u81ea\u5df1\u7684\u811a\u6b65\u3002\u724c\u7ec4\u6ca1\u5c11\u4e00\u5f20\uff0c\u8840\u4e5f\u6ca1\u5c11\u4e00\u6ef4\uff0c\u6000\u91cc\u90a3\u70b9\u7a7a\u843d\u843d\u7684\u3001\u8bf4\u4e0d\u6e05\u662f\u4ec0\u4e48\u7684\u611f\u89c9\uff0c\u5012\u6bd4\u62ff\u5230\u4ec0\u4e48\u66f4\u8ba9\u4f60\u8e0f\u5b9e\u3002\u6709\u4e9b\u4e1c\u897f\u8bf7\u4f60\u9760\u8fd1\uff0c\u53ea\u662f\u56e0\u4e3a\u5b83\u8fd8\u6ca1\u5b66\u4f1a\u7b49\u3002"
    _effects: []
