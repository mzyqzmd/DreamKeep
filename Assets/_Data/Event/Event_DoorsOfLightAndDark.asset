  _eventName: "\u6668\u95E8\xB7\u591C\u95E8"
  _background: {fileID: 11400000, guid: 60f940829a2eeab4db3783edb479f451, type: 2}
  _narrative: "\u4E24\u6247\u95E8\u5E76\u6392\u7ACB\u7740\uFF0C\u4E2D\u95F4\u6CA1\u6709\u5899\uFF0C\u50CF\u628A\u540C\u4E00\u6761\u8DEF\u5288\u6210\u4E86\u4E24\u79CD\u8D70\u6CD5\u3002\u5DE6\u8FB9\u90A3\u6247\u5E95\u4E0B\u662F\u6668\u5149\uFF0C\u6696\u6696\u5730\u6F2B\u51FA\u6765\uFF0C\u7167\u5F97\u4EBA\u60F3\u5F80\u524D\u8FC8\uFF1B\u53F3\u8FB9\u90A3\u6247\u5E95\u4E0B\u4EC0\u4E48\u90FD\u6CA1\u6709\u2014\u2014\u8FDE\u5F71\u5B50\u90FD\u6CA1\u6709\uFF0C\u9ED1\u5F97\u4E0D\u50CF\u95E8\u540E\uFF0C\u5012\u50CF\u95E8\u672C\u8EAB\u628A\u5149\u5403\u6389\u4E86\u3002\u4F60\u7AD9\u5728\u4E24\u6247\u95E8\u4E4B\u95F4\uFF0C\u624B\u91CC\u6525\u7740\u8981\u5904\u7F6E\u7684\u724C\uFF0C\u5374\u542C\u89C1\u8EAB\u540E\u6709\u4EBA\u5728\u6570\uFF1A\u4F60\u8FD8\u6709\u51E0\u5F20\u80FD\u6539\u3001\u51E0\u5F20\u80FD\u820D\u3002"
  _options:
  - _name: "\u8D70\u8FDB\u6668\u95E8"
    _subtitle: "\u5347\u7EA7\u4F60\u724C\u5E93\u4E2D\u7684 <color=yellow>2</color>
      \u5F20\u724C"
    _condition: 0
    _conditionValue: 0
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u8E0F\u5165\u6668\u5149\uFF0C\u5149\u88F9\u4F4F\u4F60\u624B\u91CC\u7684\u724C\uFF0C\u51E0\u5F20\u4F60\u6311\u4E2D\u7684\u5361\u88AB\u6668\u8272\u91CD\u65B0\u953B\u4E86\u4E00\u904D\uFF0C\u8FB9\u89D2\u90FD\u4EAE\u4E86\u8D77\u6765\u2014\u2014\u662F\u5B9E\u6253\u5B9E\u7684\u5347\u7EA7\uFF0C\u50CF\u88AB\u8FD9\u6247\u95E8\u66FF\u4F60\u6253\u78E8\u8FC7\u3002\u82E5\u4F60\u624B\u91CC\u5DF2\u7ECF\u5168\u662F\u4EAE\u8FC7\u7684\u724C\uFF0C\u6668\u5149\u4E5F\u53EA\u662F\u628A\u4F60\u4ECE\u5934\u5230\u811A\u7167\u4E86\u4E00\u904D\uFF0C\u4EC0\u4E48\u90FD\u6CA1\u62FF\u8D70\u3002\u4F60\u8D70\u51FA\u95E8\u65F6\u8EAB\u540E\u7684\u591C\u95E8\u8F7B\u8F7B\u5408\u4E0A\uFF0C\u50CF\u4ECE\u6CA1\u5F00\u8FC7\u3002"
    _effects:
    - rid: 6594183605612707869
  - _name: "\u8D70\u8FDB\u591C\u95E8"
    _subtitle: "\u4ECE\u4F60\u724C\u5E93\u4E2D\u79FB\u9664 <color=yellow>1</color>
      \u5F20\u724C"
    _condition: 3
    _conditionValue: 1
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u8FC8\u5411\u90A3\u7247\u6CA1\u6709\u5F71\u5B50\u7684\u9ED1\uFF0C\u9ED1\u91CC\u4F38\u51FA\u65E0\u5F62\u7684\u624B\uFF0C\u628A\u4F60\u6307\u5B9A\u7684\u90A3\u5F20\u724C\u8F7B\u8F7B\u62BD\u8D70\u3001\u5316\u6389\uFF0C\u8FDE\u6E23\u90FD\u4E0D\u5269\u3002\u724C\u7EC4\u56E0\u6B64\u7A7A\u51FA\u4E00\u683C\uFF0C\u50CF\u88AB\u8FD9\u6247\u95E8\u66FF\u4F60\u505A\u4E86\u4E00\u6B21\u65AD\u820D\u79BB\u2014\u2014\u54EA\u6015\u8FD9\u662F\u6700\u540E\u4E00\u5F20\uFF0C\u591C\u95E8\u4E5F\u4E0D\u963B\u62E6\u3002\u4F60\u9000\u51FA\u65F6\u8EAB\u8F7B\u4E86\u4E9B\uFF0C\u6668\u95E8\u5728\u80CC\u540E\u4F9D\u65E7\u6F2B\u7740\u5149\uFF0C\u53EA\u662F\u4F60\u8FD9\u56DE\u6CA1\u9009\u5B83\u3002"
