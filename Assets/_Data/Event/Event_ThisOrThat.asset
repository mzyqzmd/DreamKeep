  _eventName: "\u4E24\u6247\u95E8"
  _background: {fileID: 11400000, guid: 945b1efdcdbf23a42b75013e5078ae26, type: 2}
  _narrative: "\u4E24\u6761\u5C94\u8DEF\u3002\u5DE6\u8FB9\u7684\u95E8\u5E95\u4E0B\u6F0F\u8FDB\u6765\u4E00\u7EBF\u6668\u5149\uFF0C\u6E29\u6E29\u7684\uFF0C\u50CF\u6709\u4EBA\u7279\u610F\u66FF\u4F60\u7559\u7740\uFF1B\u53F3\u8FB9\u7684\u95E8\u7F1D\u5F80\u5916\u6E17\u7740\u6E29\u6C34\uFF0C\u4F60\u8D34\u4E0A\u53BB\u542C\uFF0C\u95E8\u540E\u9762\u6709\u5FC3\u8DF3\u2014\u2014\u4E00\u4E0B\uFF0C\u4E00\u4E0B\uFF0C\u4E0D\u5FEB\u4E0D\u6162\uFF0C\u50CF\u5728\u7B49\u4F60\u4E5F\u628A\u8033\u6735\u8D34\u4E0A\u6765\u3002\u4E24\u6247\u95E8\u90FD\u4E0D\u80AF\u5148\u544A\u8BC9\u4F60\u95E8\u540E\u662F\u4EC0\u4E48\uFF0C\u53EA\u628A\u5404\u81EA\u7684\u52A8\u9759\u9012\u5230\u4F60\u6307\u5C16\uFF1A\u4E00\u8FB9\u4EC0\u4E48\u90FD\u4E0D\u8BA8\uFF0C\u4E00\u8FB9\u8981\u4F60\u6536\u4E0B\u4E00\u9053\u62B9\u4E0D\u6389\u7684\u75D5\u8FF9\u3002"
  _options:
  - _name: "\u63A8\u5F00\u5DE6\u95E8"
    _subtitle: "\u5931\u53BB <color=red>6</color> \u70B9\u751F\u547D\uFF0C\u83B7\u5F97
      <color=yellow>50</color> \u91D1\u5E01"
    _condition: 2
    _conditionValue: 6
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u62B5\u4F4F\u5DE6\u95E8\uFF0C\u6668\u5149\u987A\u7740\u95E8\u7F1D\u5272\u8FC7\u4F60\u7684\u80A9\u8180\uFF0C\u50CF\u88AB\u8C01\u8F7B\u8F7B\u5212\u4E86\u4E00\u5200\u3002\u8840\u73E0\u8FD8\u6CA1\u6EF4\u5230\u5730\u4E0A\uFF0C\u95E8\u540E\u90A3\u5806\u91D1\u5C51\u5DF2\u7ECF\u6EDA\u8FDB\u4F60\u6000\u91CC\u2014\u2014\u4E94\u5341\u679A\uFF0C\u4E0D\u591A\u4E0D\u5C11\uFF0C\u6070\u597D\u591F\u4F60\u4E0B\u4E00\u6BB5\u8DEF\u7684\u82B1\u9500\u3002\u4F60\u6342\u7740\u80A9\u60F3\uFF0C\u8FD9\u6247\u95E8\u6536\u7684\u4E70\u8DEF\u94B1\uFF0C\u5012\u6BD4\u522B\u5904\u516C\u9053\u4E9B\u3002"
    _effects:
    - rid: 6594183605612707877
    - rid: 6594183605612707878
  - _name: "\u63A8\u5F00\u53F3\u95E8"
    _subtitle: "\u83B7\u5F97 <color=yellow>1</color> \u4EF6\u968F\u673A\u7A00\u6709\u9057\u7269\uFF0C\u5C06\u4E00\u5F20
      <color=yellow>\u4F24\u53E3</color> \u52A0\u5165\u4F60\u7684\u724C\u5E93"
    _condition: 0
    _conditionValue: 0
    _displayCard: {fileID: 11400000, guid: 305cdfec2482e304e9851e2309768c0b, type: 2}
    _resultText: "\u53F3\u95E8\u5728\u4F60\u638C\u5FC3\u4E0B\u8BA9\u5F00\uFF0C\u90A3\u9897\u5FC3\u8DF3\u731B\u5730\u8D34\u5230\u4F60\u80F8\u53E3\uFF0C\u53C8\u9000\u56DE\u95E8\u540E\u3002\u5B83\u7559\u4E0B\u4E00\u4EF6\u6C89\u7538\u7538\u7684\u7A00\u6709\u9057\u7269\u585E\u8FDB\u4F60\u884C\u56CA\u2014\u2014\u6765\u81EA\u9057\u7269\u6C60\uFF0C\u7EDD\u4E0D\u4E0E\u4F60\u5DF2\u6301\u6709\u7684\u91CD\u590D\u2014\u2014\u540C\u65F6\u63A8\u6765\u4E00\u5F20\u9EEF\u6DE1\u7684\u300C\u4F24\u53E3\u300D\uFF0C\u4F5C\u4E3A\u542C\u5B83\u5FC3\u8DF3\u7684\u4EE3\u4EF7\u3002\u4F60\u628A\u5B83\u4FE9\u4E00\u8D77\u6536\u597D\uFF0C\u542C\u89C1\u81EA\u5DF1\u7684\u5FC3\u8DF3\u4E5F\u4E71\u4E86\u4E00\u62CD\u3002"
