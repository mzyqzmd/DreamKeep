  _eventName: "\u65E0\u540D\u7891"
  _background: {fileID: 11400000, guid: a197901c981bb3546b9be623528a5c51, type: 2}
  _narrative: "\u4E00\u7247\u7891\uFF0C\u6CA1\u6709\u4E00\u5757\u523B\u7740\u540D\u5B57\u3002\u5B83\u4EEC\u6392\u5F97\u9F50\u6574\uFF0C\u50CF\u5728\u7B49\u8C01\u628A\u5404\u81EA\u7684\u6765\u8DEF\u8865\u4E0A\uFF0C\u53EF\u7B49\u4E86\u592A\u4E45\uFF0C\u77F3\u5934\u90FD\u5FD8\u4E86\u81EA\u5DF1\u8BE5\u8BB0\u4EC0\u4E48\u3002\u53EA\u6709\u6700\u91CC\u9762\u90A3\u5757\u662F\u7A7A\u7684\uFF0C\u77F3\u9762\u78E8\u5F97\u5F88\u5E73\uFF0C\u50CF\u5728\u7279\u610F\u7559\u767D\u7B49\u4EBA\u6765\u5199\u3002\u98CE\u7A7F\u8FC7\u7891\u6797\uFF0C\u53D1\u51FA\u5F88\u8F7B\u7684\u3001\u50CF\u53F9\u606F\u53C8\u50CF\u50AC\u4FC3\u7684\u58F0\u97F3\uFF0C\u4F60\u7AD9\u5230\u90A3\u5757\u7A7A\u7891\u524D\uFF0C\u5FFD\u7136\u89C9\u5F97\u81EA\u5DF1\u8BE5\u505A\u70B9\u4EC0\u4E48\uFF0C\u5374\u8BF4\u4E0D\u6E05\u505A\u54EA\u6837\u624D\u5BF9\u3002"
  _options:
  - _name: "\u8EBA\u8FDB\u7891\u5F71\u91CC\u6B47\u4E00\u591C"
    _subtitle: "\u6062\u590D <color=green>9</color> \u70B9\u751F\u547D\uFF0C\u5347\u7EA7\u4F60\u724C\u5E93\u4E2D\u7684
      <color=yellow>1</color> \u5F20\u724C"
    _condition: 0
    _conditionValue: 0
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u5728\u7A7A\u7891\u65C1\u8EBA\u4E0B\uFF0C\u7891\u5F71\u66FF\u4F60\u6321\u4E86\u534A\u591C\u7684\u98CE\u3002\u7761\u68A6\u91CC\u50CF\u6709\u4EBA\u66FF\u4F60\u628A\u76AE\u8089\u4E00\u5BF8\u5BF8\u7F1D\u597D\u3002\u4F60\u987A\u624B\u7FFB\u51FA\u4E00\u5F20\u6700\u5E73\u5B9E\u7684\u724C\u6401\u5728\u7891\u4E0A\uFF0C\u7891\u6587\u4FBF\u987A\u7740\u6307\u7F1D\u628A\u5B83\u8214\u4EAE\u4E86\u4E00\u5C42\uFF1B\u82E5\u4F60\u624B\u91CC\u5DF2\u7ECF\u6CA1\u6709\u53EF\u518D\u4EAE\u7684\u724C\uFF0C\u7891\u4E5F\u4E0D\u607C\uFF0C\u53EA\u5F53\u4F60\u7761\u5F97\u6C89\u3002"
    _effects:
    - rid: 6594183605612707871
    - rid: 6594183605612707872
  - _name: "\u732E\u4E00\u675F\u82B1\uFF0C\u4EC0\u4E48\u4E5F\u4E0D\u62FF"
    _subtitle: "\u83B7\u5F97 <color=yellow>1</color> \u4EF6\u968F\u673A\u666E\u901A\u9057\u7269"
    _condition: 0
    _conditionValue: 0
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u91C7\u4E86\u8DEF\u8FB9\u65E0\u540D\u7684\u5C0F\u82B1\uFF0C\u7AEF\u6B63\u6446\u5728\u7A7A\u7891\u524D\uFF0C\u4EC0\u4E48\u4E5F\u4E0D\u8981\u3002\u7891\u6797\u9759\u4E86\u7247\u523B\uFF0C\u6700\u91CC\u9762\u90A3\u5757\u5FFD\u7136\u6258\u8D77\u4E00\u4EF6\u666E\u901A\u9057\u7269\u9012\u5230\u4F60\u624B\u91CC\u2014\u2014\u6765\u81EA\u666E\u901A\u9057\u7269\u6C60\uFF0C\u50CF\u662F\u5BF9\u300C\u4E0D\u6C42\u800C\u4E88\u300D\u7684\u56DE\u793C\u3002\u4F60\u6CA1\u523B\u540D\u4E5F\u6CA1\u6398\u91D1\uFF0C\u53EA\u7559\u4E0B\u4E00\u675F\u82B1\uFF0C\u5374\u6362\u6765\u4E86\u65C1\u4EBA\u7FFB\u627E\u534A\u5929\u624D\u5F97\u5230\u7684\u786C\u8D27\u3002"
    _effects:
    - rid: 6594183605612707873
  - _name: "\u628A\u7891\u6316\u5F00"
    _subtitle: "\u5931\u53BB <color=red>10</color> \u70B9\u751F\u547D\uFF0C\u83B7\u5F97
      <color=yellow>300</color> \u91D1\u5E01\uFF0C\u5C06\u4E00\u5F20 <color=yellow>\u8D2A\u5A6A</color>
      \u52A0\u5165\u4F60\u7684\u724C\u5E93"
    _condition: 2
    _conditionValue: 11
    _displayCard: {fileID: 11400000, guid: 4c1379d594670bc4e9c7d1346fd8e8da, type: 2}
    _resultText: "\u4F60\u6284\u8D77\u7891\u65C1\u534A\u57CB\u7684\u77F3\u5757\u5228\u5F00\u7A7A\u7891\u4E0B\u7684\u571F\uFF0C\u6307\u8282\u78D5\u51FA\u4E86\u8840\uFF0C\u4E5F\u5228\u51FA\u91D1\u5C51\u2014\u2014\u6570\u76EE\u5927\u5F97\u784C\u624B\u3002\u53EF\u91D1\u5C51\u5E95\u4E0B\u538B\u7740\u4E00\u5F20\u7B11\u541F\u541F\u7684\u300C\u8D2A\u5A6A\u300D\uFF0C\u6084\u6084\u6E9C\u8FDB\u4E86\u4F60\u7684\u724C\u7EC4\uFF0C\u5F80\u540E\u6BCF\u4E00\u573A\u6218\u6597\u90FD\u8D56\u7740\u4E0D\u8D70\u3002\u4F60\u5598\u7740\u6C14\u628A\u91D1\u5C51\u6536\u8FDB\u6000\u91CC\uFF0C\u7A7A\u7891\u88AB\u4F60\u5228\u51FA\u7684\u5751\u53D6\u4EE3\uFF0C\u518D\u7ACB\u4E0D\u56DE\u539F\u5904\u3002"
