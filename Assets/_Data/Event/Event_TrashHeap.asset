  _eventName: "\u788E\u7247\u5806"
  _background: {fileID: 11400000, guid: 9a4c0afaa62e8534ea0c3fc7d60d99f8, type: 2}
  _narrative: "\u4F60\u8E29\u8FC7\u4E00\u6BB5\u5806\u6EE1\u788E\u68A6\u7684\u659C\u5761\u3002\u522B\u4EBA\u6CA1\u505A\u5B8C\u7684\u4E1C\u897F\u90FD\u4E22\u5728\u8FD9\u91CC\uFF1A\u534A\u622A\u8FD8\u4EAE\u7740\u7684\u697C\u68AF\u3001\u4E00\u53EA\u505C\u4E86\u6446\u7684\u6000\u8868\u3001\u4E00\u53E5\u5361\u5728\u300C\u5982\u679C\u300D\u4E0A\u7684\u8BDD\u3002\u7070\u5F88\u539A\uFF0C\u8E29\u4E0A\u53BB\u8F7B\u8F7B\u584C\u4E0B\u53BB\uFF0C\u9732\u51FA\u5E95\u4E0B\u96F6\u661F\u7684\u5149\u3002\u6709\u4EBA\u5728\u8FDC\u5904\u7FFB\u627E\uFF0C\u8BF4\u53EF\u4EE5\u66FF\u4F60\u628A\u90A3\u4EF6\u53D1\u4EAE\u7684\u4E1C\u897F\u6316\u51FA\u6765\uFF0C\u53EA\u8981\u4F60\u80AF\u5206\u4E00\u70B9\u8840\u7ED9\u5B83\uFF1B\u4E5F\u6709\u4EBA\u613F\u610F\u5E2E\u4F60\u628A\u6CA1\u7528\u7684\u724C\u6E05\u8D70\uFF0C\u6536\u4E03\u5341\u679A\u91D1\u5C51\u4F5C\u5DE5\u94B1\u3002\u4F60\u60F3\u751F\u4E00\u5806\u706B\uFF0C\u628A\u7070\u548C\u90A3\u4E9B\u6CA1\u8BF4\u5B8C\u7684\u8BDD\u4E00\u8D77\u70E7\u6389\uFF0C\u4E5F\u4E0D\u662F\u4E0D\u884C\u3002"
  _options:
  - _name: "\u7FFB\u627E\u788E\u7247"
    _subtitle: "\u5931\u53BB <color=red>12</color> \u70B9\u751F\u547D\uFF0C\u83B7\u5F97
      <color=yellow>1</color> \u4EF6\u968F\u673A\u666E\u901A\u9057\u7269"
    _condition: 2
    _conditionValue: 12
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u8E72\u4E0B\u6765\uFF0C\u628A\u7070\u4E00\u5C42\u5C42\u6252\u5F00\u3002\u6307\u8179\u88AB\u788E\u68A6\u7684\u8FB9\u7F18\u5212\u7834\uFF0C\u8840\u6E17\u8FDB\u7070\u91CC\uFF0C\u9A6C\u4E0A\u88AB\u5438\u5F97\u5E72\u5E72\u51C0\u51C0\u3002\u5E95\u4E0B\u9732\u51FA\u4E00\u4EF6\u8FD8\u5E26\u7740\u4F53\u6E29\u7684\u65E7\u7269\u2014\u2014\u666E\u901A\u9057\u7269\u6C60\u91CC\u968F\u673A\u7684\u4E00\u4EF6\uFF0C\u4E0D\u4E0E\u4F60\u5DF2\u6301\u6709\u7684\u91CD\u590D\u3002\u4F60\u628A\u5B83\u63E1\u5728\u624B\u91CC\uFF0C\u4F24\u53E3\u8FD8\u5728\u53D1\u70EB\u3002\u5806\u91CC\u7684\u5149\u706D\u4E86\u51E0\u5904\uFF0C\u50CF\u6709\u8C01\u66FF\u4F60\u8BB0\u4E0B\u4E86\u8FD9\u7B14\u8D26\uFF1A\u5341\u4E8C\u70B9\u8840\uFF0C\u6362\u4E00\u4EF6\u8BF4\u4E0D\u6E05\u503C\u4E0D\u503C\u7684\u4E1C\u897F\u3002\u4F60\u6CA1\u6562\u591A\u7FFB\uFF0C\u6015\u4E0B\u4E00\u4EF6\u8981\u6536\u66F4\u8D35\u7684\u4EF7\u3002"
    _effects:
    - rid: 6594184073303031808
    - rid: 6594184073303031809
  - _name: "\u8BF7\u4EBA\u6E05\u7406"
    _subtitle: "\u652F\u4ED8 <color=yellow>70</color> \u679A\u91D1\u5E01\uFF0C\u4ECE\u724C\u7EC4\u4E2D\u79FB\u9664
      <color=yellow>1</color> \u5F20\u5361"
    _condition: 1
    _conditionValue: 70
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u671D\u9634\u5F71\u91CC\u62DB\u4E86\u62DB\u624B\uFF0C\u90A3\u4E2A\u4E00\u76F4\u5728\u7FFB\u627E\u7684\u4EBA\u4FBF\u8D70\u8FC7\u6765\u3002\u4F60\u628A\u91D1\u5E01\u6570\u8FDB\u5B83\u644A\u5F00\u7684\u638C\u5FC3\uFF0C\u5B83\u4F4E\u5934\u770B\u4E86\u770B\uFF0C\u4ECE\u4F60\u644A\u5F00\u7684\u724C\u91CC\u6311\u8D70\u4E00\u5F20\u6700\u6C89\u624B\u7684\uFF0C\u6298\u4E86\u4E24\u4E0B\uFF0C\u585E\u8FDB\u90A3\u5806\u788E\u68A6\u91CC\u3002\u90A3\u5F20\u724C\u6CA1\u6709\u6323\u624E\uFF0C\u8FDE\u58F0\u97F3\u90FD\u6CA1\u53D1\u51FA\u6765\u3002\u724C\u7EC4\u56E0\u6B64\u7A7A\u51FA\u4E00\u683C\uFF0C\u91D1\u5C51\u4E5F\u6CA1\u4E86\uFF0C\u4F60\u5374\u89C9\u5F97\u624B\u91CC\u8F7B\u4E86\u4E9B\u3002\u5B83\u9000\u56DE\u9634\u5F71\u7EE7\u7EED\u7FFB\u627E\uFF0C\u50CF\u4EC0\u4E48\u4E5F\u6CA1\u53D1\u751F\uFF0C\u53EA\u7559\u4E0B\u4E00\u53E5\uFF1A\u4E0B\u6B21\u6E05\u7406\u8FD8\u662F\u8FD9\u4E2A\u4EF7\u3002"
    _effects:
    - rid: 6594184073303031810
    - rid: 6594184073303031811
  - _name: "\u751F\u4E00\u5C0F\u5806\u706B"
    _subtitle: "\u6062\u590D <color=green>5</color> \u70B9\u751F\u547D"
    _condition: 0
    _conditionValue: 0
    _displayCard: {fileID: 0}
    _resultText: "\u4F60\u628A\u80FD\u70E7\u7684\u788E\u68A6\u62E2\u5230\u4E00\u5904\uFF0C\u5212\u4EAE\u4E00\u6839\u706B\u67F4\u3002\u706B\u82D7\u5148\u662F\u5F88\u5C0F\uFF0C\u540E\u6765\u8214\u5230\u534A\u622A\u697C\u68AF\uFF0C\u4FBF\u7A33\u7A33\u5730\u4EAE\u8D77\u6765\u3002\u7070\u88AB\u70E4\u5F97\u53D1\u767D\uFF0C\u90A3\u4E9B\u5361\u5728\u300C\u5982\u679C\u300D\u4E0A\u7684\u8BDD\u5728\u706B\u91CC\u4E00\u53E5\u53E5\u5377\u8D77\u6765\uFF0C\u53D8\u6210\u5F88\u8F7B\u7684\u70DF\u3002\u4F60\u4F38\u624B\u70E4\u4E86\u70E4\uFF0C\u51BB\u50F5\u7684\u5730\u65B9\u6162\u6162\u677E\u4E86\uFF0C\u8840\u56DE\u4E86\u4E94\u70B9\uFF0C\u4E0D\u591A\uFF0C\u5374\u521A\u597D\u591F\u4F60\u518D\u8D70\u4E00\u6BB5\u8DEF\u3002\u706B\u706D\u65F6\uFF0C\u788E\u7247\u5806\u8FD8\u662F\u90A3\u7247\u788E\u7247\u5806\uFF0C\u53EA\u662F\u4F60\u4E0D\u518D\u89C9\u5F97\u5B83\u51B7\u4E86\u3002"
