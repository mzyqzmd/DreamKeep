    - _speaker: 0
      _text: "\u6311\u4E00\u4EF6\u5427\uFF0C\u522B\u7A7A\u624B\u8D70\u3002"
  - _lines:
    - _speaker: 0
      _text: "\u4F60\u7684\u706F\u771F\u4EAE\u3002"
    - _speaker: 1
      _text: "\u6211\u8D76\u65F6\u95F4\u3002"
    - _speaker: 0
