--- !u!114 &734723832
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 734723830}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1f0ef692de043ccbca3a21958070a45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleText: {fileID: 536883543}
  _description: "\u57FA\u4E8Ev0.3\uFF1A\u8FD9\u4E00\u7248\u6CA1\u52A0\u65B0\u5361\u65B0\u602A\uFF0C\u4E3B\u8981\u662F\u6536\u62FE\u6D4B\u8BD5\u5DE5\u5177\u548C\u5C11\u91CFbug\u3002\n\r\n1.\u5F00\u53D1\u9762\u677F\uFF1A\u8BBE\u7F6E\u4E2D\u53EF\u4EE5\u6253\u5F00\u662F\u5426\u542F\u7528\u6D4B\u8BD5\u6A21\u5F0F\uFF0C\u65B9\u4FBF\u5F00\u6302(\u4E0D\u662F\n\r\n2.\u9876\u680F\u8840\u91CF\uFF1A\u6700\u5927\u751F\u547D\u53D8\u5316\u73B0\u5728\u4E5F\u4F1A\u8BA9\u9876\u680F\u91CD\u5199\u8840\u91CF\u6587\u672C\u3002\u5F00\u53D1\u9762\u677F\u628A\u4E0A\u9650\u538B\u4E0B\u53BB\uFF0C\u6216\u8005\u8BFB\u6863\u5199\u56DE\u4E0A\u9650\u7684\u65F6\u5019\uFF0C\u6570\u5B57\u4F1A\u9A6C\u4E0A\u8DDF\u4E0A\uFF0C\u4E0D\u7528\u7B49\u4E0B\u4E00\u6B21\u6389\u8840\u56DE\u8840\u3002\r\n\r\n3.\u56DE\u8840\u7279\u6548\uFF1A\u5C40\u5916\u56DE\u8840\u539F\u6765\u4ECE\u5C4F\u5E55\u4E0B\u8FB9\u5192\uFF0C\u73B0\u5728\u632A\u56DE\u4E2D\u95F4\uFF0C\u770B\u7740\u6CA1\u90A3\u4E48\u602A\u3002\u6218\u6597\u91CC\u7684\u56DE\u8840\u8FD8\u662F\u8D70\u539F\u6765\u7684\u76EE\u6807\u4F4D\u7F6E\uFF0C\u4E0D\u91CD\u590D\u64AD\u3002\r\n\r\n4.\u8FD8\u6CA1\u505A\u7684(\u53D8\u61D2\u4E86\u66F4\u52A0\u4E0D\u4E00\u5B9A\u505A\u4E86)\uFF1A\u4E8B\u4EF6\u8FD8\u662F\u4E94\u5219\uFF0C\u5C40\u672B\u8FD8\u662F\u90A3\u5F20\u56FA\u5B9A\u7ED3\u7B97\u9762\u677F\uFF0C\u7EDF\u8BA1\u548C\u6570\u636E\u56DE\u987E\u6CA1\u505A\u3002\u65B0\u5361\u3001\u65B0\u602A\u3001\u65B0\u836F\u6C34\u3001\u65B0\u9057\u7269\u8FD9\u4E00\u7248\u4E5F\u6CA1\u52A0(\u4E3B\u8981\u7B2C\u4E00\u5C42\u8FD9\u4E9B\u4F53\u91CF\u5176\u5B9E\u611F\u89C9\u5F88\u591F\u7684"
