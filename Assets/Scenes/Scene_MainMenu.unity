--- !u!114 &1400556423
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1400556417}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1f0ef692de043ccbca3a21958070a45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleText: {fileID: 713528871}
  _description: "\u505A\u597D\u4E86\u5B8C\u6574\u7684\u6E38\u620F\u5FAA\u73AF\uFF0C\u80FD\u4ECE\u4E3B\u83DC\u5355\u4E00\u8DEF\u6253\u5230Boss\u3001\u6253\u5B8C\u8FD8\u80FD\u56DE\u4E3B\u83DC\u5355\u7684\u7248\u672C\u3002\u5B83\u66F4\u504F\u5411\u4E00\u6B21\u6280\u672F\u5C55\u793A\uFF1A\u5185\u5BB9\u4E0D\u7B97\u591A\u3002\r\n\r\n1.\u5B58\u6863\u7CFB\u7EDF\uFF1A\u505A\u7684\u662F\u5355\u5B58\u6863\u7CFB\u7EDF\uFF0C\u6574\u5C40\u53EA\u6709\u4E00\u4E2A\u5B58\u6863\u4F4D\uFF0C\u9009\u70B9\u548C\u6218\u6597\u80DC\u5229\u5404\u5B58\u4E00\u6B21\uFF0C\u5B9E\u73B0\u4E86\u6740\u622E\u5C16\u58542\u91CC\u9762\u7684sl\u673A\u5236\uFF0C\u4E2D\u9014\u9000\u51FA\u56DE\u6765\u70B9\u300C\u7EE7\u7EED\u300D\u80FD\u63A5\u7740\u6253\uFF0C\u4E5F\u80FD\u76F4\u63A5\u5220\u6863\u91CD\u5F00\u3002\r\n\r\n2.\u5730\u56FE\u7CFB\u7EDF\uFF1A\u5730\u56FE\u7531\u79CD\u5B50\u751F\u6210(\u81EA\u5B9A\u4E49\u79CD\u5B50\u53EF\u4EE5\u505A\u4F46\u6CA1\u505A)\uFF1A\u5148\u94FA\u8DEF\u5F84\uFF0C\u518D\u5206\u914D\u8282\u70B9\u7C7B\u578B\uFF0C\u63A5\u7740\u53BB\u6389\u91CD\u590D\u5C94\u8DEF\u3001\u8C03\u6574\u6392\u7248\uFF0C\u540C\u4E00\u79CD\u5B50\u80FD\u590D\u73B0\u540C\u4E00\u5F20\u56FE\u3002\u8282\u70B9\u6709\u666E\u901A\u6218\u6597\u3001\u7CBE\u82F1\u3001\u5546\u5E97\u3001\u5B9D\u7BB1\u3001\u4F11\u606F\u3001\u300C?\u300D\u548CBoss\uFF0C\u6BCF\u628A\u4ECE\u5148\u53E4\u4E4B\u6C11\u5F00\u573A\u3002\n\r\n3.\u6BB5\uFF1A\u6BB5\u662F\u8FD9\u4E00\u7248\u62C6\u5F97\u6700\u7EC6\u7684\u5730\u65B9\uFF1A\u6218\u6597\u3001\u5546\u5E97\u3001\u4F11\u606F\u3001\u5B9D\u7BB1\u3001\u4E8B\u4EF6\u3001\u5148\u53E4\u4E4B\u6C11\u5404\u662F\u4E00\u5957\u72EC\u7ACB\u6D41\u7A0B\uFF0C\u89C4\u5219\u5728\u540E\u53F0\u7B97\uFF0C\u753B\u9762\u53EA\u7BA1\u663E\u793A\uFF0C\u753B\u9762\u548C\u6D41\u7A0B\u4E25\u683C\u5206\u79BB\uFF0C\u6BB5\u4E0E\u6BB5\u4E4B\u95F4\u7531\u4E00\u4E2A\u88C5\u5378\u5668\u7EDF\u4E00\u8C03\u5EA6\u3002\n\n4.\u5185\u5BB9\u4FA7\u5B9E\u73B0\u4E8632\u5F20\u5361\u300159\u4EF6\u9057\u7269\u300115\u79CD\u836F\u6C34\u30015\u5219\u4E8B\u4EF6\uFF0C\u4F11\u606F\u5904\u6709\u56DE\u8840\u3001\u953B\u9020\u3001\u6316\u6398\u3001\u70F9\u996A4\u4E2A\u9009\u9879(\u540E\u9762\u4E24\u4E2A\u5206\u522B\u9700\u8981\u94F2\u5B50\u548C\u5207\u8089\u5200\u9057\u7269)\uFF0C\u5546\u5E97\u5E26\u4EF7\u683C\u6D6E\u52A8\uFF1B\u91D1\u5E01\u3001\u5361\u3001\u836F\u6C34\u3001\u9057\u7269\u7EDF\u4E00\u8D70\u4E00\u5957\u5956\u52B1\u751F\u6210\u548C\u4E00\u5957\u9886\u53D6\u9762\u677F\u3002\u97F3\u9891\u6709\u5E38\u9A7B\u7684\u97F3\u9891\u6839\u548C\u4E00\u4EFD\u96C6\u4E2D\u7BA1\u7406\u7684\u97F3\u6548\u8868\uFF0C4\u6761BGM\u52A020+\u6761\u97F3\u6548\u8986\u76D6\u6218\u6597\u3001\u5730\u56FE\u3001\u5546\u4EBA\u3001\u754C\u9762\u548C\u7ED3\u7B97\u3002\r\n\r\n5.\u63A5\u4E0B\u6765\u51C6\u5907\u505A\u7684(\u4E0D\u4E00\u5B9A\u6211\u8BF4)\uFF1A\r\n\u505A\u8FC7\u767E\u79D1\u5927\u5168\u9762\u677F\uFF0C\u65B9\u4FBF\u770B\u5361\u724C\u90A3\u4E9B\u7684\u3002\n\r\u80DC\u5229/\u5931\u8D25\u65F6\u53EA\u6709\u4E00\u5F20\u56FA\u5B9A\u7684\u7ED3\u7B97\u9762\u677F\uFF0C\u53EF\u4EE5\u505A\u5C40\u672B\u7EDF\u8BA1\u548C\u6570\u636E\u56DE\u987E\u3002
    \u6389\u843D\u6743\u91CD\u548C\u5546\u5E97\u4EF7\u683C\u521A\u8C03\u8FC7\u4E00\u8F6E\uFF0C\u7EE7\u7EED\u6309\u5B9E\u8DD1\u6570\u636E\u78E8\u6536\u76CA\u66F2\u7EBF\uFF0C\u6570\u503C\u5E73\u8861\u8FD8\u662F\u6709\u70B9\u96BE\u5EA6\u7684\uFF0C\u4E0D\u8981\u5B66\u4EBA\u5BB6\u4E1C\u5C3C\u867E\u5E73\u8861\u3002\n\u4E8B\u4EF6\u624D\u4E94\u5219\uFF0C\u786E\u5B9E\u6709\u70B9\u5C11\u53EF\u4EE5\u591A\u505A\u70B9\u3002
    \n\u505A\u66F4\u591A\u654C\u4EBA\uFF0C\u8FD9\u4E00\u7248\u5C31\u505A\u4E862\u4E2A\u666E\u901A\u654C\u4EBA1\u4E2A\u7CBE\u82F1\u548C1\u4E2ABoss,\u592A\u5C11\u4E86\u3002\r"
