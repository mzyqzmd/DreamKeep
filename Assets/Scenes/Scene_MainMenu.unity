  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1f0ef692de043ccbca3a21958070a45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleText: {fileID: 462183239}
  _description: "\u57FA\u4E8Ev0.4\uFF1A\u8FD9\u4E00\u7248\u53C8\u52A0\u4E8615\u5F20\uFF0C\u987A\u624B\u628A\u72B6\u6001\u8865\u9F50\u3002\r\u4EE5\u53CA\u4FEE\u590D\u4E00\u4E9Bbug\uFF0C\u6BD4\u5982\u7070\u6C34\u9009\u62E9\u724C\u65F6\u724C\u7684\u4F4D\u7F6E\u4E0D\u5BF9\u7B49\u7B49\u95EE\u9898\u3002\n\r\n1.\u65B0\u5361\uFF1A15\u5F20\uFF0C1\u5F20\u666E\u901A\u30018\u5F20\u7A00\u6709\u30016\u5F20\u8D85\u7A00\u6709\uFF0C\u5927\u90FD\u662F\u94C1\u7532\u6218\u58EB\u540E\u534A\u6BB5\u7684\u724C\uFF0C\u58C1\u5792\u3001\u6076\u9B54\u5F62\u6001\u3001\u9ED1\u6697\u4E4B\u62E5\u3001\u706B\u7130\u5C4F\u969C\u3001\u6218\u6597\u4E13\u6CE8\u8FD9\u4E9B\u3002\u5361\u7247\u603B\u89C8\u73B0\u5728\u4E00\u517156\u5F20\uFF0C\u767E\u79D1\u91CC\u80FD\u76F4\u63A5\u7FFB\u5230\u3002\r\n\r\n2.\u72B6\u6001\uFF1A\u8FD915\u5F20\u91CC\u4E0D\u5C11\u662F\u80FD\u529B\u724C\uFF0C\u4E3B\u8981\u4E4B\u524D\u7684\u5361\u57FA\u672C\u90FD\u662F\u6280\u80FD\u548C\u653B\u51FB\u5361\uFF0C\u5C31\u4E00\u53E3\u6C14\u505A\u4E8614\u4E2A\u3002\u72B6\u6001\u6309\u89E6\u53D1\u65F6\u673A\u5206\u6210\u51E0\u7C7B\u63A5\u4E0A\u53BB\uFF1A\u6539\u724C\u7684\u6570\u503C\u3001\u53D7\u51FB\u53CD\u4F24\u3001\u6539\u62BD\u724C\u3001\u6D88\u8017\u65F6\u89E6\u53D1\u3001\u65BD\u52A0\u72B6\u6001\u65F6\u89E6\u53D1\u3002\r\n\r\n3.\u4E8B\u4EF6\uFF1A\u8865\u4E86\u4E00\u5219\u300C\u83CC\u4E1D\u4F4E\u8BED\u300D\uFF0C\u4E00\u9762\u5899\u5728\u8DDF\u4F60\u8BF4\u8BDD\u3002\u4E09\u4E2A\u9009\u9879\uFF1A\u8BA9\u5B83\u5403\u6389\u4E24\u5F20\u724C\u3001\u6362\u4E00\u5F20\u8BC5\u5492\u300C\u5B62\u5B50\u4E4B\u5FC3\u300D\uFF1B\u5272\u5F00\u624B\u6307\u5582\u5B83\uFF0C\u62638\u70B9\u8840\u6362\u4E00\u74F6\u7A00\u6709\u836F\u6C34\uFF1B\u8F6C\u8EAB\u79BB\u5F00\u3002\n\r\n4.\u8FD8\u6CA1\u505A\u7684(\u4F9D\u65E7\u4E0D\u4E00\u5B9A)\uFF1A\u5C40\u672B\u8FD8\u662F\u90A3\u5F20\u56FA\u5B9A\u7ED3\u7B97\u9762\u677F\uFF0C\u7EDF\u8BA1\u548C\u6570\u636E\u56DE\u987E\u6CA1\u505A\u3002\u65B0\u602A\u3001\u65B0\u836F\u6C34\u3001\u65B0\u9057\u7269\u8FD9\u7248\u6CA1\u52A0\u3002\r\n"
