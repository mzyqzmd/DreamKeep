--- !u!114 &109525410
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 109525408}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1f0ef692de043ccbca3a21958070a45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleText: {fileID: 840454798}
  _description: "\u57FA\u4E8Ev0.2\uFF1A\u4E0A\u56DE\u8BF4\u7684\u767E\u79D1\u5927\u5168\u9762\u677F\u505A\u51FA\u6765\u4E86\u3002\u8FD9\u4E00\u7248\u6CA1\u52A0\u65B0\u5361\u65B0\u602A\uFF0C\u4E3B\u8981\u662F\u628A\u5DF2\u6709\u7684\u4E1C\u897F\u8FDB\u884C\u5C55\u793A\uFF0C\u987A\u624B\u7406\u4E86\u4E00\u904D\u76EE\u5F55\u548C\u4E24\u5904\u53CD\u9988\u3002\n\r\n1.\u767E\u79D1\u5927\u5168\uFF1A\u4E3B\u83DC\u5355\u591A\u4E86\u4E00\u4E2A\u767E\u79D1\u6309\u94AE\uFF0C\u70B9\u5F00\u5148\u51FA\u4E09\u5F20\u5165\u53E3\u5361\uFF0C\u5361\u7247\u603B\u89C8\u3001\u9057\u7269\u6536\u96C6\u3001\u836F\u6C34\u7814\u7A76\u6240\u5404\u4E00\u9875\uFF0C\u5B50\u9875\u8FD4\u56DE\u952E\u81EA\u5DF1\u6309\uFF0C\u5F00\u5408\u4EA4\u7ED9\u6839\u9762\u677F\u7EDF\u4E00\u7BA1\u3002\r\n\r\n2.\u5361\u7247\u603B\u89C8\uFF1A\u666E\u901A\u3001\u7A00\u6709\u3001\u8D85\u7A00\u6709\u3001\u521D\u59CB\u3001\u8BC5\u54925\u4E2A\u5361\u6C60\u5408\u5E76\u53BB\u91CD\uFF0C41\u5F20\u5361\u4E00\u6B21\u6446\u5B8C\u3002\u53EF\u4EE5\u6309\u7C7B\u578B\u3001\u7A00\u6709\u5EA6\u3001\u8D39\u7528\u4E09\u79CD\u6392\u5E8F\uFF0C\u518D\u70B9\u5F53\u524D\u90A3\u6761\u7FFB\u65B9\u5411\u3001\u70B9\u522B\u7684\u6761\u590D\u4F4D\uFF1B\u70B9\u5361\u5F00\u7EDF\u4E00\u7684\u5361\u724C\u8BE6\u60C5\u7279\u5199\u3002\u300C\u67E5\u770B\u5347\u7EA7\u300D\u80FD\u628A\u80FD\u5347\u7EA7\u7684\u5361\u6362\u6210\u5347\u7EA7\u540E\u7684\u6837\u5B50\u3002\n\r\n3.\u9057\u7269\u6536\u96C6\u548C\u836F\u6C34\u7814\u7A76\u6240\uFF1A\u9057\u7269\u6309\u521D\u59CB\u3001\u666E\u901A\u3001\u7A00\u6709\u3001\u5546\u5E97\u56DB\u7EC4\u52A0\u5148\u53E4\u4E00\u7EC4\u517159\u4EF6\uFF0C\u5148\u53E4\u90A3\u7EC4\u7684\u540D\u53F7\u548C\u5934\u50CF\u4ECE\u5148\u53E4\u914D\u7F6E\u8BFB\uFF0C\u70B9\u69FD\u4F4D\u5728\u9875\u9762\u5185\u5F00\u9057\u7269\u4FE1\u606F\u9762\u677F\uFF1B\u836F\u6C34\u6309\u666E\u901A\u3001\u7A00\u6709\u4E24\u7EC4\u517117\u79CD\uFF0C\u53EA\u6302\u56FE\u6807\u548C\u60AC\u505C\u8BF4\u660E\uFF0C\u4E0D\u7ED9\u70B9\u3002\u7A7A\u7EC4\u8FDE\u6807\u9898\u4E00\u8D77\u9690\u85CF\uFF0C\u4E09\u9875\u7EAF\u5C55\u793A\u3002\u4E3A\u8865\u5168\u6536\u5F55\u65B0\u914D\u4E86\u521D\u59CB\u724C\u6C60\u3001\u8BC5\u5492\u724C\u6C60\u3001\u521D\u59CB\u9057\u7269\u6C60\uFF0C\u5B57\u4F53\u4E5F\u8865\u4E86\u5B57\u3002\r\n\r\n4.\u987A\u624B\u4FEE\u7684\u4E24\u5904\uFF1A\u836F\u6C34\u680F\u6EE1\u4E86\u8FD8\u53BB\u9886\u836F\u6C34\uFF0C\u4EE5\u524D\u53EA\u662F\u628A\u6761\u76EE\u89E3\u9501\uFF0C\u73B0\u5728\u5185\u5BB9\u5C42\u4F1A\u5DE6\u53F3\u6296\u4E00\u4E0B\u544A\u8BC9\u4F60\u6CA1\u9886\u6210\u3002\n\r\n5.\u8FD8\u6CA1\u505A\u7684(\u4E0D\u4E00\u5B9A\u6211\u8BF4)\uFF1A\u4E8B\u4EF6\u8FD8\u662F\u4E94\u5219\uFF0C\u5C40\u672B\u8FD8\u662F\u90A3\u5F20\u56FA\u5B9A\u7ED3\u7B97\u9762\u677F\uFF0C\u7EDF\u8BA1\u548C\u6570\u636E\u56DE\u987E\u6CA1\u505A\u3002\u6570\u503C\u8FD9\u4E00\u7248\u6CA1\u518D\u52A8\uFF0C\u767E\u79D1\u4E5F\u53EA\u662F\u628A\u73B0\u6709\u7684\u6446\u51FA\u6765\uFF0C\u6CA1\u6709\u65B0\u589E\u5361\u3001\u836F\u6C34\u3001\u9057\u7269\u6216\u654C\u4EBA\u3002"
