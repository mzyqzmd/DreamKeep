--- !u!114 &364076966
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 364076964}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1f0ef692de043ccbca3a21958070a45, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleText: {fileID: 66444361}
  _description: "\u4E00\u4E0B\u5185\u5BB9\u662F\u5728 v0.1\u57FA\u7840\u4E0B\u7684\u66F4\u65B0\uFF1A
    \u5F80\u4E0B\u586B\u5185\u5BB9\uFF0C\u5361\u3001\u836F\u6C34\u3001\u654C\u4EBA\u5404\u8865\u4E86\u4E00\u6279\uFF0C\u5730\u56FE\u548C\u6570\u503C\u4E5F\u91CD\u65B0\u8C03\u4E86\u4E00\u8F6E\u3002\u5185\u5BB9\u8FD8\u662F\u4E0D\u7B97\u591A\u3002\r\n\r\n1.\u5361\u724C\u65B0\u589E
    9 \u5F20\uFF0C\u666E\u901A 4 \u5F20\u3001\u7A00\u6709 2 \u5F20\u3001\u8D85\u7A00\u6709
    3 \u5F20\u3002\n\u6B66\u88C5 1 \u8D39\uFF0C\u83B7\u5F97 5 \u70B9\u683C\u6321\uFF0C\u4ECE\u4F60\u7684\u624B\u724C\u4E2D\u9009\u53D6
    1 \u5F20\u8FDB\u884C\u5347\u7EA7(\u5347\u7EA7\u624B\u724C\u4E2D\u7684\u6240\u6709\u724C)\uFF1B\n\u5C0F\u795E\u8BDD
    0 \u8D39\uFF0C\u5347\u7EA7\u624B\u724C\u4E2D\u7684\u6240\u6709\u724C\u518D\u62BD1\u5F20\uFF0C\u6253\u51FA\u540E\u4ECE\u6574\u5C40\u6E38\u620F\u91CC\u6C38\u4E45\u79FB\u9664(\u5347\u7EA7\u540E\u6539\u6210\u53EA\u5728\u672C\u573A\u6218\u6597\u6D88\u8017)\uFF1B\n\u7239\uFF01\u4F60\u6CA1\u6B7B\u554A
    2 \u8D39\uFF0C\u6D88\u8017\u624B\u724C\u4E2D\u7684\u6240\u6709\u724C\uFF0C\u62BD
    10 \u5F20(\u5347\u7EA7\u540E 1 \u8D39)\u3002\n\u8FD8\u6709\u4E0B\u7838\u3001\u5E73\u9759\u3001\u6E38\u620F\u672C\u8D28\u3001\u51C0\u5316\u3001\u9707\u8361\u6CE2\u3001\u70D9\u5370\u3002\n\r\n2.\u836F\u6C34\u65B0\u589E
    2 \u79CD\uFF1A\u7070\u6C34(\u4ECE\u624B\u724C\u91CC\u4EFB\u9009\u51E0\u5F20\u6D88\u8017\uFF0C\u4E5F\u53EF\u4EE5\u4E00\u5F20\u4E0D\u9009)\u3001\n\u7532\u866B\u6C41(\u5BF9\u4E00\u540D\u654C\u4EBA\u65BD\u52A0
    4 \u5C42\u7F29\u5C0F)\u3002\n\n3.\u72B6\u6001\u65B0\u589E 5 \u4E2A\uFF1A\n\u7F29\u5C0F(\u63A5\u4E0B\u6765\u51E0\u56DE\u5408\u9020\u6210\u7684\u4F24\u5BB3-30%\uFF0C\u65BD\u52A0\u8005\u6B7B\u4E86\u5C31\u89E3\u9664)\u3001\n\u6ED1\u6E9C(\u4E0B\u51E0\u6B21\u8981\u6389\u8840\u65F6\u53EA\u6389
    1 \u70B9)\u3001\n\u5931\u8861(\u653B\u51FB\u88AB\u5B8C\u5168\u683C\u6321\u5C31\u88AB\u51FB\u6655)\u3001\n\u9886\u5730\u610F\u8BC6(\u81EA\u5DF1\u56DE\u5408\u7ED3\u675F\u65F6\u83B7\u5F97\u529B\u91CF)\u3001\n\u9AD8\u5899(\u56DE\u5408\u7ED3\u675F\u65F6\u81EA\u5DF1\u548C\u76DF\u53CB\u83B7\u5F97\u683C\u6321)\u3002\r\n\r\n3.\u654C\u4EBA\u8865\u5F97\u6700\u591A\uFF1A\n\u666E\u901A\u654C\u4EBA\u591A\u4E86\n\u58A8\u5B9D(14
    \u8840\uFF0C\u81EA\u5E26\u6ED1\u6E9C\uFF0C\u600E\u4E48\u6253\u6BCF\u6B21\u6700\u591A\u6389
    1 \u70B9\u8840)\u3001\n\u7F29\u5C0F\u7532\u866B(32 \u8840\uFF0C\u5F00\u5C40\u7ED9\u4F60\u6302\u6EE1\u7F29\u5C0F\uFF0C\u8FDB\u4E8C\u9636\u6BB5\u6539\u6253
    8 \u70B9\u548C 12 \u70B9)\u3001\n\u6BDB\u7ED2\u4F0F\u5730\u866B(38 \u8840\uFF0C\u4E00\u8DEF\u7ED9\u81EA\u5DF1\u53E0
    7 \u5C42\u300110 \u5C42\u529B\u91CF)\u3001\n\u8BAD\u7EC3\u673A\u5668\u4EBA v1/v2/v3(15/20/25
    \u8840\uFF0C\u5B8C\u5168\u4E0D\u6253\u4EBA\uFF0C\u56DE\u5408\u7ED3\u675F\u7ED9\u81EA\u5DF1\u548C\u76DF\u53CB\u52A0
    3/4/5 \u70B9\u683C\u6321\uFF0C\u53EA\u5F53\u652F\u63F4\u4F4D\u51FA\u73B0)\u3002\n\u7CBE\u82F1\u4ECE
    1 \u7EC4\u8865\u5230 3 \u7EC4\uFF1A\n\u76DB\u7897\u866B\u5BB6\u65CF\u871C\u3001\u4E1D\u3001\u77F3\u4E09\u53EA\u540C\u573A\u6362\u524D\u6392\uFF0C\n\u77F3\u5934
    46 \u8840\u300116 \u70B9\u5934\u69CC\uFF0C\u8FD9\u4E00\u4E0B\u88AB\u5B8C\u5168\u683C\u6321\u5C31\u76F4\u63A5\u88AB\u51FB\u6655\uFF1B\n\u591A\u5C3C\u65AF\u5F02\u9E1F
    95 \u8840\uFF0C18 \u70B9\u5355\u53D1\u30013\xD73\u3001\u7AD9\u524D\u6392 3\xD74\uFF0C\u6BCF\u4E2A\u81EA\u5DF1\u56DE\u5408\u7ED3\u675F\u90FD\u52A0
    1 \u70B9\u529B\u91CF\uFF0C\u8D8A\u62D6\u8D8A\u75BC\u3002\n\u65B0\u654C\u4EBA\u90FD\u914D\u4E86\u52A8\u4F5C\u548C\u53F0\u8BCD\uFF0C\u58A8\u5B9D\u4F1A\u558A\u300C\u6253\u6ED1\u6253\u6ED1\uFF01\u300D\uFF0C\u5F02\u9E1F\u5F00\u53E3\u5C31\u662F\u300C\u8FD9\u91CC\u662F\u6211\u7684\u5730\u76D8\uFF01\u300D\u3002\r\n\r\n4.\u906D\u9047\u91CD\u65B0\u6392\u4E86\u4E00\u904D\uFF1A\n\u5F31\u6C60
    4 \u79CD\uFF0C\u5F3A\u6C60\u4ECE 2 \u79CD\u8865\u5230 7 \u79CD\uFF0C\u7CBE\u82F1
    3 \u7EC4\uFF0CBoss \u8FD8\u662F\u4EEA\u5F0F\u517D\uFF0C\u524D 6 \u5C42\u53EA\u51FA\u5F31\u6C60\u3002\u5730\u56FE\u4E0A\u7CBE\u82F1\u70B9
    10 \u4E2A\u6539 12 \u4E2A\uFF0C\u95EE\u53F7\u70B9\u5E73\u5747 18 \u4E2A\u6539
    20 \u4E2A\u3001\u6700\u5C11 18 \u4E2A\uFF1B\u95EE\u53F7\u91CC\u649E\u4E8B\u4EF6
    35 \u6539 55\uFF0C\u649E\u666E\u901A\u6218\u6597 25 \u6539 15\u3001\u7CBE\u82F1\u548C\u5546\u5E97\u5404
    15 \u6539 10\uFF0C\u4E0D\u518D\u5F00\u51FA\u4F11\u606F\u70B9\u3002\n\n5.\u6570\u503C\u4E5F\u8C03\u4E86\u4E00\u8F6E\uFF1A\n\u6A59\u578B\u9999\u76D2\u6361\u8D77\u65F6\u6389\u8840
    5 \u70B9\u6539 9 \u70B9\uFF0C\u677E\u52A8\u7F8A\u6BDB\u526A 7 \u70B9\u6539 13
    \u70B9\uFF1B\n\u6218\u540E\u51FA\u5347\u7EA7\u5361\u7684\u6982\u7387\u666E\u901A\u6218\u6597
    5% \u6539 3%\u3001\u7CBE\u82F1 10% \u6539 5%\uFF1B\n\u5546\u5E97\u534A\u4EF7\u5361\u73B0\u5728\u76F4\u63A5\u663E\u793A\u5B9E\u4ED8\u4EF7\uFF1B\n\u4E3B\u83DC\u5355
    Logo \u52A8\u753B\u4E5F\u4FEE\u597D\u4E86\u3002\r\n\r\n6.\u4E0A\u56DE\u8BF4\u7684\u767E\u79D1\u5927\u5168\u9762\u677F\u8FD8\u662F\u6CA1\u505A\uFF0C\u4E8B\u4EF6\u8FD8\u662F\u4E94\u5219\uFF08\u6211\u8BF4\u522B\u6025\uFF09"
